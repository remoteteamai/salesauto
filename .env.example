# ===========================================
# Melioro AI - Environment Configuration
# ===========================================

# Application
NODE_ENV=development
APP_NAME=Melioro AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://melioro:melioro_secret@localhost:5432/melioro

# Authentication - Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Authentication - JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Redis (for caching and queues)
REDIS_URL=redis://localhost:6379

# Stripe (Billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_ID_STARTER=price_starter_id
STRIPE_PRICE_ID_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_id

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@melioro.ai

# AI Services
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Data Enrichment APIs
CLEARBIT_API_KEY=your-clearbit-api-key
HUNTER_API_KEY=your-hunter-api-key
ZOOMINFO_API_KEY=your-zoominfo-api-key
Apollo_API_KEY=your-apollo-api-key

# Intent Data
BOMBORO_API_KEY=your-bomboro-api-key
G2_API_KEY=your-g2-api-key

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# File Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=melioro-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Monitoring
SENTRY_DSN=your-sentry-dsn
GRAFANA_PASSWORD=your-grafana-admin-password

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_AI_SDR=true
ENABLE_LINKEDIN_INTEGRATION=true